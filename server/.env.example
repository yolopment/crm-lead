PORT=5000
NODE_ENV=development

# SQL Database URL (PostgreSQL by default; for MySQL: mysql://user:pass@host:3306/crm_lead)
DATABASE_URL="postgresql://crm_user:crm_password@localhost:5432/crm_lead?schema=public"

# JWT Secret
JWT_SECRET="super-secret-jwt-token-replace-in-production-12345"
JWT_EXPIRES_IN="7d"

# Storage Configuration Options:
# 'local'  -> Hostinger VPS local disk (./uploads/recordings)
# 'r2'     -> Cloudflare R2 (🏆 Lowest cost, 10 GB free forever, 0$ bandwidth)
# 'gdrive' -> Google Drive storage only
# 'dual'   -> BOTH CONNECTED (Streams from Cloudflare R2 in CRM + Syncs backup to Google Drive folder)
STORAGE_DRIVER=local

# Local Storage (used when STORAGE_DRIVER=local)
RECORDINGS_DIR="./uploads/recordings"
MAX_AUDIO_SIZE_MB=50

# Cloudflare R2 / AWS S3 Configuration
# S3_ENDPOINT="https://<YOUR_CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_ACCESS_KEY_ID="your_r2_or_s3_access_key"
# S3_SECRET_ACCESS_KEY="your_r2_or_s3_secret_key"
# S3_BUCKET="crm-call-recordings"
# S3_PUBLIC_URL=""

# Google Drive Storage Configuration
# Option 1: File path to Service Account JSON key (e.g. ./google-service-account.json)
# GOOGLE_APPLICATION_CREDENTIALS="./google-service-account.json"
# Option 2: Raw Service Account JSON string in environment variable
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"..."}'
# Target Google Drive Folder ID (created in Google Drive and shared with service account email):
# GOOGLE_DRIVE_FOLDER_ID="1a2b3c4d5e6f7g8h9i0j_folder_id"

# Per-Client Google Drive OAuth Configuration (Clients connect their own 15 GB Free Drive)
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web application)
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:5001/api/v1/integrations/gdrive/callback"
FRONTEND_URL="http://localhost:3000"

# Razorpay Payment Gateway (Phase 4: SaaS Billing & Subscriptions)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Meta Ads Webhook Verification Token
META_VERIFY_TOKEN="leadzam_meta_verify_token_secure"
META_ACCESS_TOKEN=""

# CORS Origins (Comma separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:5000,https://yourdomain.com"

