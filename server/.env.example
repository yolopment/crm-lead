PORT=5000
NODE_ENV=development

# SQL Database URL (PostgreSQL by default; for MySQL: mysql://user:pass@host:3306/crm_lead)
DATABASE_URL="postgresql://crm_user:crm_password@localhost:5432/crm_lead?schema=public"

# JWT Secret
JWT_SECRET="super-secret-jwt-token-replace-in-production-12345"
JWT_EXPIRES_IN="7d"

# Storage Configuration (Optimized for Hostinger VPS local NVMe storage)
# In production on Hostinger: /var/crm/recordings
RECORDINGS_DIR="./uploads/recordings"
MAX_AUDIO_SIZE_MB=50

# Meta Ads Webhook Verification Token
META_VERIFY_TOKEN="leadzam_meta_verify_token_secure"
META_ACCESS_TOKEN=""

# CORS Origins (Comma separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:5000,https://yourdomain.com"

